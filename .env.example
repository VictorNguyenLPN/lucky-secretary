# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# LLM (OpenAI-compatible; defaults to Google Gemini Free Tier)
# For Gemini Free Tier: get API key at https://aistudio.google.com/apikey
# For OpenAI: leave OPENAI_BASE_URL empty and set OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
OPENAI_MODEL=gemini-3.5-flash-lite
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Google Calendar OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/
GOOGLE_TOKEN_PATH=./data/google_token.json

# Application
APP_ENV=development
DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh
DEFAULT_EVENT_DURATION=60
CONFIRMATION_TIMEOUT_MINUTES=15

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/lucky_secretary.db

